---
import Layout from '../../layouts/Layout.astro';
import LibraryMock from '../../components/LibraryMock.astro';
import Icon from '../../components/Icon.astro';
import PlatformList from '../../components/PlatformList.astro';
import { communityRepo, introVideo } from '../../data/site';
import { pluginCopy } from '../../i18n/plugins';
import { localePath, locales, t, type Locale } from '../../i18n/ui';

export const getStaticPaths = () => locales.map((l) => ({ params: { lang: l.code } }));
const locale = Astro.params.lang as Locale;
const d = t(locale);
const titleLines = d.hero.title.split('\n');
const plugin = pluginCopy[locale];
const videoHost = introVideo.sources[locale].find((host) => introVideo[host]);
const video = videoHost === 'bilibili'
  ? { embed: `https://player.bilibili.com/player.html?bvid=${introVideo.bilibili}&autoplay=0&danmaku=0&high_quality=1`, page: `https://www.bilibili.com/video/${introVideo.bilibili}/` }
  : videoHost === 'youtube'
    ? { embed: `https://www.youtube-nocookie.com/embed/${introVideo.youtube}?rel=0`, page: `https://www.youtube.com/watch?v=${introVideo.youtube}` }
    : null;
---
<Layout locale={locale} current="home" title={d.meta.homeTitle} description={d.meta.homeDesc}>
  <section class="hero wrap">
    <div class="hero-copy">
      <div class="hero-title">
        <p class="free-label"><Icon name="check" size={16} />{d.hero.free}</p>
        <h1>{titleLines.map((line) => <span>{line}</span>)}</h1>
      </div>
      <div class="hero-side">
        <p class="lead">{d.hero.lead}</p>
        <div class="cta-row">
          <a class="btn primary" href={localePath(locale, '/download/')}><Icon name="download" size={18} />{d.hero.cta}</a>
          <a class="btn" href={localePath(locale, '/wiki/')}>{d.hero.ctaWiki}</a>
        </div>
        <a class="text-link hero-rom-link" href="#rom-sync"><Icon name="cloud" size={18} />{d.hero.romLink}<Icon name="arrow" size={16} /></a>
        <p class="fine">{d.hero.meta}</p>
      </div>
    </div>
    <LibraryMock locale={locale} />
  </section>

  {video && videoHost && (
    <section class="wrap intro-video" aria-labelledby="intro-video-title">
      <h2 id="intro-video-title">{d.video.title}</h2>
      <div class="video-frame">
        <iframe src={video.embed} title={d.video.title} loading="lazy" allow="fullscreen; picture-in-picture; encrypted-media" referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <a class="text-link" href={video.page} target="_blank" rel="noopener">{d.video.watchOn.replace('%s', d.video.names[videoHost])}<Icon name="arrow" size={16} /></a>
    </section>
  )}

  <section class="wrap stats" aria-label="RetroMao">
    {d.stats.map(([n, label]) => <div><strong>{n}</strong><span>{label}</span></div>)}
  </section>

  <section class="wrap shelf">
    <PlatformList locale={locale} />
  </section>

  <section class="band">
    <div class="wrap">
      <h2>{d.local.title}</h2>
      <ol class="steps">
        {d.local.steps.map(([title, body]) => <li><h3>{title}</h3><p>{body}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="wrap sync rom-sync" id="rom-sync" aria-labelledby="rom-title">
    <div class="sync-copy">
      <p class="eyebrow">{d.romSync.eyebrow}</p>
      <h2 id="rom-title">{d.romSync.title.split('\n').map((line) => <span>{line}</span>)}</h2>
      <p>{d.romSync.body}</p>
      <a class="text-link" href={localePath(locale, '/wiki/cloud-sync/')}>{d.romSync.more}<Icon name="arrow" size={16} /></a>
    </div>
    <ul class="rom-points">
      {d.romSync.points.map(([title, body]) => <li><h3>{title}</h3><p>{body}</p></li>)}
    </ul>
  </section>

  <section class="wrap sync" id="save-sync">
    <div class="sync-copy">
      <h2>{d.sync.title}</h2>
      <p>{d.sync.body}</p>
      <p class="fine">{d.sync.pair}</p>
      <a class="text-link" href={localePath(locale, '/wiki/saves/')}>{d.sync.more}<Icon name="arrow" size={16} /></a>
    </div>
    <div class="sync-visual" aria-hidden="true">
      <div class="sync-nodes">
        <div class="node"><Icon name="android" size={26} />{d.sync.device}</div>
        <div class="link"></div>
        <div class="node cloud"><Icon name="cloud" size={26} />{d.sync.cloud}</div>
        <div class="link"></div>
        <div class="node"><Icon name="ds" size={26} />{d.sync.ds}</div>
      </div>
      <div class="timeline">
        <span class="timeline-label">{d.sync.versions}</span>
        <svg viewBox="0 0 420 96" role="presentation">
          <path d="M14 34H178" class="line" />
          <path d="M178 34c34 0 34 44 70 44h44" class="line alt" />
          <path d="M178 34H406" class="line" />
          <circle cx="14" cy="34" r="6" /><circle cx="96" cy="34" r="6" /><circle cx="178" cy="34" r="6" />
          <circle cx="292" cy="78" r="7" class="fork" /><circle cx="292" cy="34" r="7" class="fork" />
          <circle cx="406" cy="34" r="6" />
        </svg>
        <span class="timeline-fork">{d.sync.fork}</span>
      </div>
    </div>
  </section>

  <section class="wrap control">
    <div class="ratios" aria-hidden="true">
      <div class="ratio r169"><span>16:9</span></div>
      <div class="ratio r43"><span>4:3</span></div>
      <div class="ratio r11"><span>1:1</span></div>
      <div class="ratio rdual"><i></i><i></i><span>{d.control.dual}</span></div>
    </div>
    <div>
      <h2>{d.control.title}</h2>
      <p>{d.control.body}</p>
      <div class="keys" aria-hidden="true">
        {d.mock.hints.map(([keys, label]) => <span>{keys.split(' ').map((k) => <kbd>{k}</kbd>)}{label}</span>)}
      </div>
    </div>
  </section>

  <section class="plugin-band">
    <div class="wrap">
      <p class="eyebrow">{plugin.eyebrow}</p>
      <div class="plugin-head">
        <h2>{plugin.title}</h2>
        <p>{plugin.lead}</p>
      </div>
      <div class="plugin-grid">
        <ul class="plugin-points">
          {plugin.points.map(([title, body]) => <li><h3>{title}</h3><p>{body}</p></li>)}
        </ul>
        <div class="plugin-demo" aria-hidden="true">
          <div class="code-panel">
            <span class="code-file">plugin.json</span>
            <pre>{`{
  "id": "example.hello",
  "version": "1.0.0",
  "entryPoint": "main.js",
  "capabilities": ["LIBRARY_READ"],
  "pages": [{ "id": "main", "path": "index.html" }],
  "actions": [{ "id": "count" }]
}`}</pre>
            <span class="code-file">main.js</span>
            <pre>{`retromao.define({ actions: {
  async count() {
    const page = await retromao.library.records({ limit: 200 });
    await retromao.tasks.progress(page.games.length);
    return { total: page.games.length };
  }
} });`}</pre>
          </div>
          <div class="permission-sheet">
            <strong>{plugin.permission.title}</strong>
            <span>{plugin.permission.body}</span>
            <ul>{plugin.permission.caps.map((c) => <li>{c}</li>)}</ul>
            <span class="permission-allow">{plugin.permission.allow}</span>
          </div>
        </div>
      </div>
      <div class="cta-row plugin-cta">
        <a class="btn primary" href={localePath(locale, '/wiki/plugins/')}>{plugin.eyebrow}<Icon name="arrow" size={16} /></a>
        <a class="btn" href={localePath(locale, '/wiki/contribute-plugin/')}>{plugin.guide}</a>
        <a class="btn" href={communityRepo} rel="noopener" target="_blank"><Icon name="github" size={18} />RetroMao-Community</a>
      </div>
    </div>
  </section>

  <section class="wrap published">
    <div class="section-head">
      <h2>{plugin.publishedTitle}</h2>
      <p>{plugin.publishedNote}</p>
    </div>
    <ul class="published-list">
      {plugin.published.map(([name, body]) => <li><strong>{name}</strong><span>{body}</span></li>)}
    </ul>
  </section>

  <section class="wrap ext">
    <div class="section-head">
      <h2>{plugin.kindsTitle}</h2>
      <p>{plugin.kindsLead}</p>
    </div>
    <ul class="ext-list">
      {plugin.kinds.map(([name, body, runsCode, href]) => (
        <li>
          <a href={localePath(locale, `/${href}`)}>
            <strong>{name}</strong>
            <span>{body}</span>
            <em class:list={['code-tag', { runs: runsCode }]}>{runsCode ? plugin.code : plugin.noCode}</em>
            <Icon name="arrow" size={18} />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="closing wrap">
    <img src="/logo.png" alt="" width="72" height="72" />
    <h2>{d.closing.title}</h2>
    <a class="btn primary" href={localePath(locale, '/download/')}><Icon name="download" size={18} />{d.hero.cta}</a>
    <p class="fine">{d.closing.note}</p>
  </section>
</Layout>

---
import SiteHeader from '../components/SiteHeader.astro';
import { langOf, localePath, locales, stripLocale, t, type Locale } from '../i18n/ui';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props { locale: Locale; current: 'home' | 'download' | 'changelog' | 'about' | 'none'; title: string; description: string }
const { locale, current, title, description } = Astro.props;
const path = stripLocale(Astro.url.pathname);
const d = t(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={langOf(locale)} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    {locales.map((l) => <link rel="alternate" hreflang={l.lang} href={new URL(localePath(l.code, path), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAF8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0D0E10" />
    <script is:inline>
      (function () {
        var s = null;
        try { s = localStorage.getItem('starlight-theme'); } catch (e) {}
        document.documentElement.dataset.theme = s === 'light' || s === 'dark' ? s
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <header class="page-header"><SiteHeader locale={locale} current={current} /></header>
    <main id="main"><slot /></main>
    <footer class="page-footer">
      <div class="wrap footer-grid">
        <p>{d.footer.legal}</p>
        <p class="copyright">Copyright © 2026 4NPC. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

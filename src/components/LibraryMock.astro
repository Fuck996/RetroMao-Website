---
import { demoGames } from '../data/site';
import models from '../data/models.json';
import { t, type Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = t(locale).mock;
const first = demoGames[0];
const modelUrl = (system: string) => `/models/${(models as Record<string, string>)[system]}`;
const systems = [...new Set(demoGames.map((g) => g.system))];
const themes = ['modern', 'library', 'warm', 'black'] as const;
const facts = (g: (typeof demoGames)[number]) => [String(g.year), g.genre[locale]];
const favorite = (i: number) => i === 0;
const dataset = (g: (typeof demoGames)[number], i: number) => ({
  'data-index': i, 'data-title': g.title, 'data-tint': g.tint, 'data-cover': g.cover, 'data-spine': g.spine,
  'data-system': g.system, 'data-model': modelUrl(g.system), 'data-facts': facts(g).join('|'),
});
const icon = {
  search: '<circle cx="10.500" cy="10.500" r="6"/><path d="m15 15 5 5"/>',
  heart: '<path d="M12 20s-7.500-4.600-7.500-10A4.300 4.300 0 0 1 12 7.400 4.300 4.300 0 0 1 19.500 10c0 5.400-7.500 10-7.500 10Z"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.600 5.600l2.100 2.100M16.300 16.300l2.100 2.100M5.600 18.400l2.100-2.100M16.300 7.700l2.100-2.100"/>',
  play: '<path d="M8 5.500v13l10-6.500Z"/>',
  more: '<circle cx="6" cy="12" r="1.400"/><circle cx="12" cy="12" r="1.400"/><circle cx="18" cy="12" r="1.400"/>',
  check: '<circle cx="12" cy="12" r="8.500"/><path d="m8.500 12 2.500 2.500 4.500-5"/>',
  caret: '<path d="m6 9 6 6 6-6"/>',
  menu: '<path d="M5 7h14M5 12h14M5 17h14"/>',
  stack: '<rect x="4" y="4" width="11" height="11" rx="2"/><path d="M9 20h9a2 2 0 0 0 2-2V9"/>',
  grid: '<rect x="4" y="4" width="4" height="4"/><rect x="10" y="4" width="4" height="4"/><rect x="16" y="4" width="4" height="4"/><rect x="4" y="10" width="4" height="4"/><rect x="10" y="10" width="4" height="4"/><rect x="16" y="10" width="4" height="4"/><rect x="4" y="16" width="4" height="4"/><rect x="10" y="16" width="4" height="4"/><rect x="16" y="16" width="4" height="4"/>',
};
const svg = (name: keyof typeof icon) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;
---
<figure class="mock-figure">
  <div class="mock" data-style="modern" style={`--tint:${first.tint}`}>
    <div class="m-top" aria-hidden="true">
      <span class="m-caret" set:html={svg('caret')}></span>
      <div class="m-pills">
        {m.nav.map((label, i) => (
          <span class:list={{ on: i === 0 }}>{i === 0 && <b class="m-sys" data-current-system>{first.system.toUpperCase()}</b>}{label}</span>
        ))}
      </div>
      <div class="m-search">
        <i set:html={svg('search')}></i><em>{m.searchGames}</em><kbd>L3</kbd>
      </div>
    </div>

    <!-- 流光、简约：左侧详情 + 右侧封面网格 -->
    <div class="m-view m-view-grid">
      <div class="m-detail">
        <div class="m-model" data-stage-slot></div>
        <div class="m-info">
          <strong data-field="title">{first.title}</strong>
          <div class="m-chips" data-field="facts">{facts(first).map((f) => <span>{f}</span>)}</div>
          <div class="m-status"><i set:html={svg('check')}></i>{m.local}</div>
        </div>
      </div>
      <div class="m-grid" role="listbox" aria-label={m.nav[0]}>
        {demoGames.map((g, i) => (
          <button type="button" class="cover" role="option" tabindex={i === 0 ? 0 : -1} aria-selected={i === 0 ? 'true' : 'false'} style={`--cover-aspect:${g.aspect}`} {...dataset(g, i)}>
            <span class="art">
              <img src={g.cover} alt="" width="200" height="234" loading="lazy" />
              {favorite(i) && <span class="fav" set:html={svg('heart')}></span>}
              <span class="name-in">{g.title}</span>
            </span>
            <span class="name">{g.title}</span>
          </button>
        ))}
      </div>
      <div class="m-actions" aria-hidden="true">
        <span class="round" set:html={svg('gear')}></span>
        <span class="round" set:html={svg('heart')}></span>
        <span class="play"><i set:html={svg('play')}></i>{m.play}</span>
      </div>
    </div>

    <!-- 藏馆：机种栏 + 游戏列表 + 右侧详情面板 -->
    <div class="m-view m-view-list">
      <div class="m-rail" aria-hidden="true">
        {systems.map((s) => (
          <span class:list={['m-rail-item', { on: s === first.system }]} data-rail={s}><b>{s.toUpperCase()}</b><small>{s.toUpperCase()}</small></span>
        ))}
        <span class="m-rail-item all"><b set:html={svg('grid')}></b><small>{m.all}</small></span>
      </div>
      <div class="m-list" role="listbox" aria-label={m.nav[0]}>
        {demoGames.map((g, i) => (
          <button type="button" class="row" role="option" tabindex="-1" aria-selected={i === 0 ? 'true' : 'false'} {...dataset(g, i)}>
            <img src={g.cover} alt="" width="48" height="56" loading="lazy" />
            <span class="row-text"><strong>{g.title}</strong><small>{facts(g).join(' · ')}</small></span>
            <span class="row-icons"><i set:html={svg('check')}></i>{favorite(i) && <i class="filled" set:html={svg('heart')}></i>}</span>
            <span class="row-time">—</span>
          </button>
        ))}
        <div class="m-list-actions" aria-hidden="true">
          <span class="play"><i set:html={svg('play')}></i>{m.play}</span>
          <span class="round" set:html={svg('heart')}></span>
          <span class="round" set:html={svg('more')}></span>
        </div>
      </div>
      <div class="m-panel">
        <div class="m-panel-model" data-stage-slot>
          <span class="m-panel-status"><i set:html={svg('check')}></i>{m.local}</span>
        </div>
        <div class="m-chips" data-field="facts">{facts(first).map((f) => <span>{f}</span>)}</div>
      </div>
    </div>

    <div class="m-hints" aria-hidden="true">
      {m.hints.map(([keys, label]) => (
        <span>{keys.split(' ').map((k) => <kbd>{k}</kbd>)}{label}</span>
      ))}
      <span class="only-library"><kbd>L3</kbd>{m.search}</span>
      <span><i set:html={svg('menu')}></i>{m.pickSystem}</span>
      <span><i set:html={svg('stack')}></i>{m.systemSettings}</span>
    </div>

    <div class="stage" data-stage>
      <img class="stage-fallback" src={first.cover} alt="" width="200" height="234" />
      <canvas class="stage-canvas" aria-hidden="true" data-model={modelUrl(first.system)} data-cover={first.cover} data-spine={first.spine}></canvas>
      <div class="plinth" aria-hidden="true"></div>
    </div>
  </div>
  <figcaption>
    <span>{m.caption}</span>
    <span class="mock-themes" role="group">
      {themes.map((id, i) => (
        <button type="button" data-theme-id={id} aria-pressed={i === 0 ? 'true' : 'false'}>{m.themes[id]}</button>
      ))}
    </span>
  </figcaption>
  <p class="model-license">{m.modelLicense}</p>
</figure>

<script>
  import type { ModelStage } from '../scripts/model-stage';

  const webglAvailable = () => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  };
  // three.js 只在模型快要进入视野时才下载。
  const loadStage = () => import('../scripts/model-stage').then((m) => m.ModelStage);

  document.querySelectorAll<HTMLElement>('.mock-figure').forEach((fig) => {
    const mock = fig.querySelector<HTMLElement>('.mock')!;
    const tiles = [...fig.querySelectorAll<HTMLButtonElement>('.cover')];
    const rows = [...fig.querySelectorAll<HTMLButtonElement>('.row')];
    const stageBox = fig.querySelector<HTMLElement>('[data-stage]')!;
    const slots = fig.querySelectorAll<HTMLElement>('[data-stage-slot]');
    const canvas = fig.querySelector<HTMLCanvasElement>('.stage-canvas')!;
    const fallback = fig.querySelector<HTMLImageElement>('.stage-fallback')!;

    // 3D 舞台只有一份，跟随当前风格放进对应的详情区。
    const placeStage = () => slots[mock.dataset.style === 'library' ? 1 : 0].prepend(stageBox);
    placeStage();

    let stage: ModelStage | null = null;
    let lastSelection: DOMStringMap | null = null;
    if (webglAvailable()) {
      const start = new IntersectionObserver(async ([entry]) => {
        if (!entry.isIntersecting) return;
        start.disconnect();
        const Stage = await loadStage();
        stage = new Stage(canvas);
        // 模型载入前用户可能已经选了别的游戏，以最新选择为准。
        const pick = lastSelection ?? canvas.dataset;
        stage.display(pick.model!, pick.cover!, pick.spine).then(() => mock.classList.add('has-3d'));
      }, { rootMargin: '200px' });
      start.observe(canvas);
    }

    const select = (index: number, focus = false) => {
      const list = mock.dataset.style === 'library' ? rows : tiles;
      [tiles, rows].forEach((group) => group.forEach((item, i) => {
        item.setAttribute('aria-selected', String(i === index));
        item.tabIndex = group === list && i === index ? 0 : -1;
      }));
      const data = tiles[index].dataset;
      fig.querySelector<HTMLElement>('[data-field="title"]')!.textContent = data.title!;
      fig.querySelectorAll<HTMLElement>('[data-field="facts"]').forEach((box) => {
        box.replaceChildren(...data.facts!.split('|').map((text) => {
          const chip = document.createElement('span');
          chip.textContent = text;
          return chip;
        }));
      });
      fig.querySelector<HTMLElement>('[data-current-system]')!.textContent = data.system!.toUpperCase();
      fig.querySelectorAll<HTMLElement>('[data-rail]').forEach((r) => r.classList.toggle('on', r.dataset.rail === data.system));
      fallback.src = data.cover!;
      mock.style.setProperty('--tint', data.tint!);
      lastSelection = data;
      stage?.display(data.model!, data.cover!, data.spine);
      if (focus) list[index].focus();
    };

    const wire = (group: HTMLButtonElement[], columnsOf: () => number) => group.forEach((item, i) => {
      item.addEventListener('click', () => select(i));
      item.addEventListener('keydown', (e) => {
        const columns = columnsOf();
        const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -columns, ArrowDown: columns }[e.key];
        if (step === undefined) return;
        e.preventDefault();
        if (group[i + step]) select(i + step, true);
      });
    });
    wire(tiles, () => tiles.filter((t) => t.offsetTop === tiles[0].offsetTop).length);
    wire(rows, () => 1);

    const buttons = fig.querySelectorAll<HTMLButtonElement>('[data-theme-id]');
    buttons.forEach((b) => b.addEventListener('click', () => {
      mock.dataset.style = b.dataset.themeId;
      buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      placeStage();
      select(Math.max(tiles.findIndex((t) => t.getAttribute('aria-selected') === 'true'), 0));
    }));
  });
</script>

<style is:global>
  .mock-figure { margin: 0; }

  /*
   * 尺寸按 App 在 1280×720 下的实际布局换算，--u 相当于 1dp。
   * 对照 app/build/reports/ui-screenshots 的 modern-details-logo、library-list、library-grid-black、library-controls-warm。
   */
  .mock {
    --m-bg: #0D0E10; --m-surface: #1A1B1F; --m-high: #26272C; --m-fg: #F2F3F5; --m-muted: #989BA3; --m-line: #2F3036; --m-pill: #F2F3F5; --m-on-pill: #0D0E10;
    --tint: #EF7029;
    container-type: inline-size;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: clamp(12px, 2vw, 24px);
    background: var(--m-bg);
    color: var(--m-fg);
    box-shadow: 0 0 0 1px var(--line), 0 28px 70px -30px rgb(0 0 0 / 0.5);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    position: relative;
    isolation: isolate;
    line-height: 1.3;
  }
  .mock * { --u: calc(100cqw / 1280); }
  .mock svg { display: block; width: 100%; height: 100%; }
  .mock::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, color-mix(in srgb, var(--tint) 46%, transparent), transparent 66%);
    transition: background 400ms var(--ease);
  }
  .mock[data-style='warm'] { --m-bg: #FAFAF8; --m-surface: #F1F1EE; --m-high: #DDDDD8; --m-fg: #262625; --m-muted: #70706B; --m-line: #DDDDD8; --m-pill: #343432; --m-on-pill: #FAFAF8; }
  .mock[data-style='black'] { --m-bg: #000; --m-surface: #141416; --m-high: #2A2A2E; --m-fg: #F4F4F5; --m-muted: #97979D; --m-line: #303034; --m-pill: #fff; --m-on-pill: #000; }
  .mock:is([data-style='warm'], [data-style='black'])::before { display: none; }

  /* 顶栏 */
  .m-top { display: flex; align-items: center; justify-content: space-between; gap: calc(16 * var(--u)); padding: calc(8 * var(--u)) calc(16 * var(--u)) 0; min-width: 0; }
  .m-caret { display: none; width: calc(24 * var(--u)); height: calc(24 * var(--u)); margin-inline-start: calc(12 * var(--u)); flex: none; }
  .m-pills {
    display: flex; align-items: center; gap: calc(2 * var(--u)); margin-inline-end: auto; padding: calc(4 * var(--u));
    height: calc(56 * var(--u)); border-radius: 999px; background: color-mix(in srgb, var(--m-surface) 72%, transparent);
    font-size: calc(16 * var(--u));
  }
  .m-pills > span { display: flex; align-items: center; height: calc(40 * var(--u)); padding-inline: calc(18 * var(--u)); border-radius: 999px; color: var(--m-muted); white-space: nowrap; }
  .m-pills .on { background: var(--m-pill); color: var(--m-on-pill); font-weight: 500; }
  .m-sys { margin-inline-end: calc(9 * var(--u)); font-weight: 800; font-style: italic; letter-spacing: -0.02em; }
  .m-search {
    display: flex; align-items: center; gap: calc(10 * var(--u)); flex: none; height: calc(40 * var(--u)); padding-inline: calc(13 * var(--u));
    border-radius: 999px; background: color-mix(in srgb, var(--m-surface) 72%, transparent); color: var(--m-fg); font-size: calc(14 * var(--u));
  }
  .m-search i { width: calc(18 * var(--u)); height: calc(18 * var(--u)); }
  .m-search em { display: none; font-style: normal; color: var(--m-muted); }
  .m-search kbd { padding: calc(3 * var(--u)) calc(7 * var(--u)); border-radius: 99px; background: var(--m-high); font: 700 calc(10.5 * var(--u)) var(--font-ui); }

  .m-view { position: relative; min-height: 0; }
  .m-view-list { display: none; }
  .mock[data-style='library'] .m-view-grid { display: none; }
  .mock[data-style='library'] .m-view-list { display: grid; }

  /* 流光：左侧详情 + 4 列封面，名称在卡片下方，操作按钮浮在右下角 */
  .m-view-grid { display: grid; grid-template-columns: calc(320 * var(--u)) minmax(0, 1fr); gap: calc(40 * var(--u)); padding: calc(24 * var(--u)) calc(40 * var(--u)) 0 calc(28 * var(--u)); }
  .m-detail { display: flex; flex-direction: column; min-height: 0; }
  .m-model { position: relative; flex: 1 1 auto; min-height: 0; }
  .stage { position: absolute; inset: 0; display: grid; place-items: center; }
  .stage-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; opacity: 0; transition: opacity 240ms var(--ease); }
  .stage-canvas:active { cursor: grabbing; }
  .stage-fallback { width: 52%; height: auto; box-shadow: 0 calc(12 * var(--u)) calc(30 * var(--u)) rgb(0 0 0 / 0.4); transition: opacity 240ms var(--ease); }
  .mock.has-3d .stage-canvas { opacity: 1; }
  .mock.has-3d .stage-fallback { opacity: 0; }
  .plinth {
    position: absolute; bottom: 0; left: 4%; right: 4%; height: calc(56 * var(--u)); border-radius: 50%; z-index: -1;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--m-fg) 26%, transparent), transparent);
  }
  .m-info { display: grid; gap: calc(9 * var(--u)); padding-block: calc(14 * var(--u)) calc(10 * var(--u)); font-size: calc(13 * var(--u)); color: var(--m-muted); }
  .m-info strong { color: var(--m-fg); font-size: calc(22 * var(--u)); font-weight: 700; text-align: center; }
  .m-chips { display: flex; flex-wrap: wrap; gap: calc(6 * var(--u)); }
  .m-chips span { padding: calc(4 * var(--u)) calc(11 * var(--u)); border-radius: 99px; background: var(--m-high); color: var(--m-muted); font-size: calc(12 * var(--u)); }
  .m-status { display: flex; align-items: center; gap: calc(5 * var(--u)); font-size: calc(12 * var(--u)); }
  .m-status i, .m-panel-status i { width: calc(14 * var(--u)); height: calc(14 * var(--u)); }

  .m-grid { --tile: calc(300 * var(--u)); display: flex; flex-wrap: wrap; align-items: flex-start; align-content: flex-start; gap: calc(14 * var(--u)) calc(18 * var(--u)); overflow: hidden; min-height: 0; padding: calc(6 * var(--u)); margin: calc(-6 * var(--u)); }
  .cover {
    all: unset; box-sizing: border-box; display: flex; flex-direction: column; flex: none; gap: calc(8 * var(--u)); cursor: pointer; width: calc(var(--tile) * var(--cover-aspect, 0.854));
    font-size: calc(14 * var(--u)); color: var(--m-muted);
  }
  .cover .art { position: relative; display: block; width: 100%; height: var(--tile); flex: none; border-radius: calc(14 * var(--u)); background: var(--m-surface); }
  .cover .art img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .cover .fav { position: absolute; right: calc(8 * var(--u)); bottom: calc(8 * var(--u)); width: calc(28 * var(--u)); height: calc(28 * var(--u)); padding: calc(6 * var(--u)); border-radius: 50%; background: rgb(0 0 0 / 0.72); color: #fff; }
  .cover .fav path, .row .filled path { fill: currentColor; }
  .cover .name { padding-inline: calc(2 * var(--u)); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-weight: 500; }
  .cover .name-in { display: none; }
  .cover[aria-selected='true'] { color: var(--m-fg); font-weight: 700; }
  .cover[aria-selected='true'] .art { outline: calc(3 * var(--u)) solid var(--m-fg); outline-offset: calc(3 * var(--u)); }
  .cover:focus-visible .art { outline-color: var(--accent); }

  .m-actions { position: absolute; right: calc(32 * var(--u)); bottom: calc(4 * var(--u)); display: flex; gap: calc(10 * var(--u)); }
  .round, .play { display: flex; align-items: center; justify-content: center; height: calc(52 * var(--u)); background: var(--m-pill); color: var(--m-on-pill); box-shadow: 0 calc(6 * var(--u)) calc(18 * var(--u)) rgb(0 0 0 / 0.35); }
  .round { width: calc(52 * var(--u)); padding: calc(15 * var(--u)); border-radius: calc(16 * var(--u)); }
  .play { gap: calc(8 * var(--u)); padding-inline: calc(26 * var(--u)); border-radius: 999px; font-size: calc(15 * var(--u)); font-weight: 500; white-space: nowrap; }
  .play i { width: calc(18 * var(--u)); height: calc(18 * var(--u)); }

  /* 底部按键提示 */
  .m-hints { display: flex; align-items: center; gap: calc(14 * var(--u)); padding: calc(10 * var(--u)) calc(16 * var(--u)) calc(8 * var(--u)); font-size: calc(12 * var(--u)); color: var(--m-muted); white-space: nowrap; overflow: hidden; }
  .m-hints span { display: inline-flex; align-items: center; gap: calc(5 * var(--u)); }
  .m-hints i { width: calc(16 * var(--u)); height: calc(16 * var(--u)); }
  .m-hints kbd { min-width: calc(20 * var(--u)); padding: calc(3 * var(--u)) calc(6 * var(--u)); text-align: center; border-radius: 99px; background: var(--m-high); color: var(--m-fg); font: 700 calc(10 * var(--u)) var(--font-ui); }
  .only-library { display: none !important; }
  .mock[data-style='library'] .only-library { display: inline-flex !important; }

  /* 藏馆：顶栏搜索框展开；机种栏、列表、右侧 300dp 详情面板 */
  .mock[data-style='library'] .m-search { width: calc(260 * var(--u)); }
  .mock[data-style='library'] .m-search em { display: block; flex: 1; }
  .m-view-list { grid-template-columns: calc(84 * var(--u)) minmax(0, 1fr) calc(300 * var(--u)); gap: calc(32 * var(--u)); padding: calc(20 * var(--u)) calc(28 * var(--u)) 0 calc(28 * var(--u)); }
  .m-rail { display: flex; flex-direction: column; align-items: center; gap: calc(6 * var(--u)); min-height: 0; }
  .m-rail-item { display: grid; justify-items: center; gap: calc(4 * var(--u)); width: calc(72 * var(--u)); padding-block: calc(8 * var(--u)); border-radius: calc(14 * var(--u)); color: var(--m-muted); font-size: calc(11 * var(--u)); }
  .m-rail-item b { display: grid; place-items: center; width: calc(44 * var(--u)); height: calc(30 * var(--u)); border-radius: calc(8 * var(--u)); background: var(--m-surface); color: var(--m-fg); font-size: calc(11 * var(--u)); font-weight: 800; font-style: italic; }
  .m-rail-item small { font-size: inherit; }
  .m-rail-item.on { background: var(--m-surface); color: var(--m-fg); font-weight: 700; }
  .m-rail-item.on b { background: var(--m-fg); color: var(--m-bg); }
  .m-rail-item.all { margin-top: auto; }
  .m-rail-item.all b { padding: calc(6 * var(--u)) calc(13 * var(--u)); }

